#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /opt/airplay-usb/run.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 8
    procd_set_param file /opt/airplay-usb/airplay.conf
    procd_close_instance
}
